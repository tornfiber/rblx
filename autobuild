-- ================= WALK FUNCTION =================
local function walkToTarget(humanoid, hrp, targetPart)
	if not walkEnabled then
		humanoid:MoveTo(hrp.Position) -- cancel
		return
	end
	
	if not targetPart or not targetPart.Parent then
		humanoid:MoveTo(hrp.Position)
		return
	end

	local targetPos = targetPart.Position
	local direction = (targetPos - hrp.Position)
	local distance = direction.Magnitude

	if distance <= MOVE_THRESHOLD then
		humanoid:MoveTo(hrp.Position) -- hard cancel
		return
	end

	direction = direction.Unit

	-- 🎯 NEW: stop MOVE_THRESHOLD studs away
	local stopPosition = targetPos - (direction * MOVE_THRESHOLD)

	-- Prevent jitter spam
	if lastMoveTarget and (lastMoveTarget - stopPosition).Magnitude < 2 then
		return
	end

	lastMoveTarget = stopPosition
	humanoid:MoveTo(stopPosition)
end
-- ================= MAIN LOOP =================
task.spawn(function()
	while task.wait(0.1) do
		
		if not screenGui or not screenGui.Parent then 
			break 
		end

		if not auraEnabled then continue end
		
		-- Cleanup processed parts
		if os.clock() - lastCleanup > 5 then
			for part, timeHit in pairs(processedParts) do
				if os.clock() - timeHit > PART_COOLDOWN then
					processedParts[part] = nil
				end
			end
			lastCleanup = os.clock()
		end
		
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not humanoid then continue end

		local overlapParams = OverlapParams.new()
		overlapParams.FilterType = Enum.RaycastFilterType.Include
		overlapParams.FilterDescendantsInstances = {buildFolder}
		
		local nearbyParts = workspace:GetPartBoundsInRadius(hrp.Position, auraRange, overlapParams)
		
		local closestPart = nil
		local shortestDistance = math.huge 

		for _, part in ipairs(nearbyParts) do
			if isValid(part) then
				local distance = (part.Position - hrp.Position).Magnitude
				if distance < shortestDistance then
					shortestDistance = distance
					closestPart = part
				end
			end
		end

		if closestPart then
			
			-- WALK
			walkToTarget(humanoid, hrp, closestPart)

			-- HIT LOGIC
			local currentTime = os.clock()
			local lastHit = processedParts[closestPart]
			
			local isLegitReady = not legitModeEnabled or (currentTime - lastFireTime >= legitCooldown)
			local isPartReady = not lastHit or (currentTime - lastHit > PART_COOLDOWN)

			if isLegitReady and isPartReady then
				processedParts[closestPart] = currentTime
				lastFireTime = currentTime
				remote:FireServer(closestPart)
			end
		end
	end
end)
