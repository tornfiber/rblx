local auraRange = 150 
local rng = Random.new()
local legitCooldown = rng:NextNumber(0.8, 1.5)

local buildFolder = workspace:WaitForChild("Buildings")
local remote = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("RemoteEvent_Hammer")

-- Anti-lag
local processedParts = {} 
local PART_COOLDOWN = .5 
local lastCleanup = os.clock()
local lastFireTime = 0

-- Walk settings
local lastMoveTarget = nil
local MOVE_THRESHOLD = 15

-- ================= VALIDATION =================
local function isValid(obj)
	if not obj or not obj:IsDescendantOf(buildFolder) or not obj:IsA("BasePart") then return false end
	if math.abs(obj.Transparency - 0.4) > 0.01 then return false end
	
	local name = obj.Name
	local blacklist = {ClearArea = true, Blueprint = true, Hitbox = true, Box = true, Boundary = true}
	return not blacklist[name]
end

