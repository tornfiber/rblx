local lastMoveTarget = nil
local MOVE_THRESHOLD = 15

-- ================= VALIDATION =================
local function isValid(obj)
    if not obj
        or not obj:IsDescendantOf(buildFolder)
        or not obj:IsA("BasePart") then
        return false
    end

    if math.abs(obj.Transparency - 0.4) > 0.01 then
        return false
    end

    local blacklist = {
        ClearArea = true,
        Blueprint = true,
        Hitbox = true,
        Box = true,
        Boundary = true
    }

    return not blacklist[obj.Name]
end

