local player = game.Players.LocalPlayer
local mouse = player:GetMouse()
local replicatedStorage = game:GetService("ReplicatedStorage")
local harvestRemote = replicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("RemoteEvent_Harvest")

-- Configuration
local harvestMode = false
local radius = 30 -- Range in studs

-- Function to find and harvest models in range
mouse.Button1Down:Connect(function()
    if not harvestMode then return end
    
    local clickPosition = mouse.Hit.Position
    if not clickPosition then return end

    -- Define the overlap parameters (optional: filters out players)
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {player.Character}

    -- Find all parts within the 350-stud radius of the click
    local nearbyParts = workspace:GetPartBoundsInRadius(clickPosition, radius, params)
    
    -- Use a table to track which models we've already fired for (to avoid spam)
    local processedModels = {}

    for _, part in ipairs(nearbyParts) do
        local building = part:FindFirstAncestorOfClass("Model")
        
        if building and not processedModels[building] then
            processedModels[building] = true
            
            print("Area Harvesting: " .. building.Name)
            
            -- Fire the server for each unique building found
            -- Based on your top snippet, the Harvest remote expects {Model, Part}
            local args = {
                building,
                part
            }
            harvestRemote:FireServer(unpack(args))
        end
    end
end)

-- Toggle Logic (Press 'X' to enable/disable)
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.X then
        harvestMode = not harvestMode
        print("Area Harvest Mode: " .. (harvestMode and "ON" or "OFF"))
    end
end)
