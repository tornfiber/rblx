-- Notification
local function notify(text)
    local n = Instance.new("TextLabel")
    n.Size = UDim2.new(0,200,0,40)
    n.Position = UDim2.new(1,-210,1,-50)
    n.BackgroundColor3 = Color3.fromRGB(40,40,40)
    n.TextColor3 = Color3.new(1,1,1)
    n.Text = text
    n.Parent = ScreenGui
    task.wait(2)
    n:Destroy()
end

