-- Create buttons
local function createScript(script)

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1,0,0,40)
    Frame.BackgroundColor3 = Color3.fromRGB(40,40,40)
    Frame.Parent = Scroll

    local Name = Instance.new("TextLabel")
    Name.Text = script.name
    Name.Size = UDim2.new(0.5,0,1,0)
    Name.BackgroundTransparency = 1
    Name.TextColor3 = Color3.new(1,1,1)
    Name.Parent = Frame

    local Run = Instance.new("TextButton")
    Run.Text = "Execute"
    Run.Size = UDim2.new(0,80,0,30)
    Run.Position = UDim2.new(1,-170,0.5,-15)
    Run.BackgroundColor3 = Color3.fromRGB(80,130,255)
    Run.TextColor3 = Color3.new(1,1,1)
    Run.Parent = Frame

    local Copy = Instance.new("TextButton")
    Copy.Text = "Copy"
    Copy.Size = UDim2.new(0,70,0,30)
    Copy.Position = UDim2.new(1,-80,0.5,-15)
    Copy.BackgroundColor3 = Color3.fromRGB(80,80,80)
    Copy.TextColor3 = Color3.new(1,1,1)
    Copy.Parent = Frame

    Run.MouseButton1Click:Connect(function()

        notify("Loading "..script.name)

        local code = game:HttpGet(script.url)
        loadstring(code)()

        notify("Executed "..script.name)

    end)

    Copy.MouseButton1Click:Connect(function()

        setclipboard(script.url)
        notify("Copied link")

    end)

end

-- Load scripts
for _,s in ipairs(Scripts) do
    createScript(s)
end

Scroll.CanvasSize = UDim2.new(0,0,0,#Scripts*46)

-- Dragging
local dragging=false
local dragStart
local startPos

Top.InputBegan:Connect(function(input)
if input.UserInputType==Enum.UserInputType.MouseButton1 then
dragging=true
dragStart=input.Position
startPos=Main.Position
end
end)

Top.InputEnded:Connect(function(input)
if input.UserInputType==Enum.UserInputType.MouseButton1 then
dragging=false
end
end)

UIS.InputChanged:Connect(function(input)

if dragging then
local delta=input.Position-dragStart
Main.Position=UDim2.new(
startPos.X.Scale,
startPos.X.Offset+delta.X,
startPos.Y.Scale,
startPos.Y.Offset+delta.Y
)
end

end)

-- Close
Close.MouseButton1Click:Connect(function()
ScreenGui:Destroy()
end)

